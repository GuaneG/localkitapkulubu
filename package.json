{
  "name": "localkitapkulubu",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "pnpm --filter @local/web dev",
    "build": "pnpm --filter @local/web build",
    "start": "pnpm --filter @local/web start",
    "lint": "pnpm --filter @local/web lint",
    "typecheck": "pnpm --filter @local/web typecheck",
    "test:e2e": "pnpm --filter @local/web test:e2e",
    "test:unit": "pnpm --filter @local/web test:unit",
    "test:integration": "pnpm --filter @local/web test:integration",
    "db:migrate": "pnpm --filter @local/web db:migrate",
    "admin:provision": "pnpm --filter @local/web admin:provision"
  }
}
