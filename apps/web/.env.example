# Copy to .env.local; never commit real values. Public pages do not need these.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
# Only the CLI bootstrap needs these; remove ADMIN_PASSWORD afterwards.
ADMIN_EMAIL=po@example.com
ADMIN_PASSWORD=replace-with-a-unique-shared-password
# Integration tests reset tables: use a separate disposable PostgreSQL database.
TEST_DATABASE_URL=
ALLOW_TEST_DATABASE_RESET=
