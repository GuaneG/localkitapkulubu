{
  "name": "@local/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "playwright test",
    "test:unit": "node --import tsx --test test/unit/*.test.ts",
    "test:integration": "node --conditions=react-server --import tsx --test --test-concurrency=1 test/integration/*.test.ts",
    "db:migrate": "node --conditions=react-server --import tsx scripts/migrate.ts",
    "admin:provision": "node --conditions=react-server --import tsx scripts/provision-admin.ts"
  },
  "dependencies": {
    "@next/env": "16.4.2",
    "better-auth": "1.7.24",
    "drizzle-orm": "0.45.4",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
